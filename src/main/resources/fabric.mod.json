{
	"schemaVersion": 1,
	"id": "fakedeath",
	"version": "${version}",
	"name": "Fake Death",
	"description": "A convincing fake death with a scene that fits the moment. Only you see it, nothing is sent to the server.",
	"authors": [
		"derpvpclient"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/fake-death",
		"issues": "https://github.com/derpvpclient/fake-death/issues",
		"sources": "https://github.com/derpvpclient/fake-death"
	},
	"license": "MIT",
	"icon": "assets/fakedeath/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.derpvpclient.fakedeath.FakeDeathClient"
		],
		"modmenu": [
			"de.derpvpclient.fakedeath.FakeDeathModMenu"
		]
	},
	"mixins": [
		{
			"config": "fakedeath.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/fake-death",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/fake-death"
			}
		}
	}
}
